// Emmy Social Digital Hub — Production Database Schema
// Optimized for Neon Postgres (PgBouncer connection pooling + Direct migrations)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum TransactionStatus {
  pending
  processing
  successful
  completed
  failed
  awaiting_fulfillment
}

enum GatewayType {
  jejelay_virtual_account
  paystack
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  phone           String            @unique
  name            String
  passwordHash    String
  walletBalance   BigInt            @default(0) // Stored strictly in integer kobo (₦1.00 = 100 kobo)
  role            Role              @default(user)
  totpSecret      String?           // Mandatory 2FA secret for admin accounts
  emailVerified   Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  transactions    Transaction[]
  virtualAccounts VirtualAccount[]
  fundings        WalletFunding[]
  supportTickets  SupportTicket[]

  @@index([email])
  @@index([phone])
}

model Transaction {
  id                String            @id @default(cuid())
  userId            String
  jejelayReference  String?           @unique // Unique reference returned by JejeLaye purchase response
  idempotencyKey    String            @unique // Generated by client/route to prevent double-charging
  serviceType       String            // airtime, data, electricity, tv, education, virtual_number, etc.
  providerServiceId String            // upstream service ID on JejeLaye
  target            String            // Phone number, meter number, or smart card number
  amountCostKobo    BigInt            // Wholesale cost debited by JejeLaye
  amountChargedKobo BigInt            // Retail price charged to user wallet
  status            TransactionStatus @default(pending)
  providerResponse  Json?             // Raw JSON response payload for audit & PIN/token retrieval
  metadata          Json?             // Extra data: package code, variation_id, plan name, etc.
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([jejelayReference])
}

model VirtualAccount {
  id                String   @id @default(cuid())
  userId            String
  bankName          String   // e.g. Moniepoint, Wema, Sterling Bank
  accountNumber     String   @unique
  accountName       String
  providerReference String?
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalletFunding {
  id         String      @id @default(cuid())
  userId     String
  reference  String      @unique
  amountKobo BigInt
  gateway    GatewayType
  status     String      // success, pending, failed
  paidAt     DateTime?
  createdAt  DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reference])
}

model ServiceCache {
  id                String   @id @default(cuid())
  type              String   // airtime, data, electricity, tv, education, etc.
  providerServiceId String   // ID on JejeLaye catalog
  name              String   // e.g. "MTN SME Data 1GB - 30 Days"
  network           String?  // MTN, AIRTEL, GLO, 9MOBILE
  providerPriceKobo BigInt   // Current wholesale price
  ourPriceKobo      BigInt   // Marked-up price presented to customers
  rawJson           Json?    // Complete raw object from provider for fidelity
  isActive          Boolean  @default(true)
  lastSyncedAt      DateTime @default(now())

  @@unique([type, providerServiceId])
  @@index([type, isActive])
}

model WebhookLog {
  id        String   @id @default(cuid())
  source    String   // "jejelaye-otp" | "paystack" | "esim"
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([source, processed])
}

model FloatLog {
  id          String   @id @default(cuid())
  balanceKobo BigInt   // Balance recorded from GET /wallet
  source      String   // "auto" (cron) | "manual" (admin check)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model SupportTicket {
  id                   String   @id @default(cuid())
  userId               String
  subject              String
  message              String
  transactionReference String?
  status               String   @default("open") // open, in_progress, resolved, closed
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionReference])
}
