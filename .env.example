# ==========================================
# EMMY SOCIAL DIGITAL HUB — ENVIRONMENT CONFIGURATION
# ==========================================

# Brand Identity
NEXT_PUBLIC_APP_NAME="Emmy Social Digital Hub"
NEXT_PUBLIC_APP_SHORT_NAME="Emmy Hub"
NEXT_PUBLIC_APP_URL="https://emmydigitalhub.com"

# Provider (JejeLaye API v1)
JEJELAYE_API_TOKEN="your_jejelaye_bearer_token_here"
JEJELAYE_BASE_URL="https://jejelayegct.com.ng/api/v1"
JEJELAYE_WEBHOOK_SECRET="your_jejelaye_webhook_secret_here"

# Database (Neon Postgres with PgBouncer connection pooling)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Upstash Redis (Distributed Sliding-Window Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token_here"

# QStash (Serverless Async Queue Dispatcher)
QSTASH_TOKEN="your_qstash_token_here"
QSTASH_CURRENT_SIGNING_KEY="sig_key_current"
QSTASH_NEXT_SIGNING_KEY="sig_key_next"

# Security & Authentication
JWT_SECRET="generate_a_random_32_byte_secret_here"
BCRYPT_ROUNDS="12"

# Paystack Payment Gateway (Secondary Funding)
PAYSTACK_SECRET_KEY="sk_live_sample"
PAYSTACK_PUBLIC_KEY="pk_live_sample"

# Application URL & Cron Authentication
APP_URL="https://emmydigitalhub.com"
CRON_SECRET="your_cron_bearer_secret_token_here"

# Float Liquidity Monitoring Thresholds (in Kobo: ₦1.00 = 100 kobo)
FLOAT_LOW_THRESHOLD_KOBO="5000000"       # ₦50,000 (Triggers admin warning alert)
FLOAT_CRITICAL_THRESHOLD_KOBO="1000000"  # ₦10,000 (Halts purchases to prevent failed orders)
